# ---- Python cache / bytecode ----
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Packaging / build ----
build/
dist/
*.egg-info/
.eggs/

# ---- Archives ----
*.zip

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- Notes ----
# data/ and output/ are intentionally kept (tracked) so they are pushed.
# Their .gitkeep files ensure the folders exist even when empty.
